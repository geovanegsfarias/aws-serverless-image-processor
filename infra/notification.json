{
  "LambdaFunctionConfigurations": [
    {
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:000000000000:function:image-processor",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "suffix", "Value": ".jpg" }
          ]
        }
      }
    },
    {
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:000000000000:function:image-processor",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            { "Name": "suffix", "Value": ".png" }
          ]
        }
      }
    },
    {
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:000000000000:function:image-processor",
